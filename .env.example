# =============================================================================
# FREDDY Server Environment Variables
# Copy this file to .env and fill in your actual values
# =============================================================================

# Timezone
TZ=America/Toronto

# User/Group IDs (run `id` command to get your values)
PUID=1000
PGID=1000

# =============================================================================
# PHOTOPRISM
# =============================================================================
PHOTOPRISM_ADMIN_PASSWORD=changeme
PHOTOPRISM_DB_NAME=photoprism
PHOTOPRISM_DB_USER=photoprism
PHOTOPRISM_DB_PASSWORD=changeme

# =============================================================================
# NEXTCLOUD
# =============================================================================
NEXTCLOUD_DB_NAME=nextcloud
NEXTCLOUD_DB_USER=nextcloud
NEXTCLOUD_DB_PASSWORD=changeme
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=changeme

# =============================================================================
# AUDIOBOOKSHELF
# =============================================================================
# Volumes are defined as named volumes bound to /mnt/1tb/audiobookshelf/
# No additional env vars needed beyond PUID/PGID/TZ

# =============================================================================
# AUTHENTIK SSO
# =============================================================================
# Generate with: openssl rand -hex 32
AUTHENTIK_SECRET_KEY=changeme_generate_with_openssl_rand_hex_32
AUTHENTIK_POSTGRES_USER=authentik
AUTHENTIK_POSTGRES_PASSWORD=changeme_secure_password

# Email Configuration (for Authentik notifications)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_FROM=your-email@example.com
EMAIL_USERNAME=your-email@example.com
EMAIL_PASSWORD=your-app-specific-password

# Authentik Error Reporting (optional - leave empty to disable)
AUTHENTIK_ERROR_REPORTING__ENABLED=false

# =============================================================================
# NETWORKING
# =============================================================================
# Sullivan server Tailscale IP (for nginx reverse proxy)
SULLIVAN_TAILSCALE_IP=100.87.125.19

# =============================================================================
# SHELFMARK - audiobook/ebook organiser, request API, Discord bot
# =============================================================================
# The API and worker start without any of these; every integration is optional
# and the readiness endpoint only checks what is configured. Fill them in as
# each piece is connected.

# Bearer token clients must present to the Shelfmark API. Generate with:
#   openssl rand -hex 32
SHELFMARK_API_TOKEN=

# Audiobookshelf runs on this host; the URL is the container name.
# Create a least-privilege API key in ABS (Settings > Users > API Keys).
AUDIOBOOKSHELF_API_TOKEN=
AUDIOBOOKSHELF_LIBRARY_ID=

# Prowlarr and qBittorrent live on Sullivan. Use its private address, not a
# container name — Freddy and Sullivan are separate Docker hosts and their
# container DNS does not cross.
PROWLARR_URL=
PROWLARR_API_KEY=
QBITTORRENT_URL=
QBITTORRENT_USERNAME=
QBITTORRENT_PASSWORD=

# Discord bot. The bot service sits behind the `discord` compose profile and
# will not start until these are set:
#   docker compose --profile discord up -d discordarr
DISCORD_BOT_TOKEN=
SHELFMARK_DISCORD_GUILD_ID=
SHELFMARK_DISCORD_ALLOWED_ROLE_IDS=
# discordarr's /movie, /show and /music go straight to sullivan's Radarr,
# Sonarr and Lidarr; their URLs default to sullivan's tailnet address.
RADARR_API_KEY=
SONARR_API_KEY=
LIDARR_API_KEY=

# Override only if the media tree ownership on this host changes. See the
# comment above the shelfmark services in docker-compose.yml.
SHELFMARK_UID=1001
SHELFMARK_GID=1001

# Private key for the restricted shelfmark-sync account on sullivan. Generate
# it ON FREDDY so the private half never travels:
#   ssh-keygen -t ed25519 -N "" -f /tmp/shelfmark-sync -C "shelfmark@freddy"
# Put the PRIVATE half in the GitHub secret SHELFMARK_SULLIVAN_SSH_KEY, install
# the PUBLIC half on sullivan with scripts/provision-sullivan-sync.sh from the
# shelfmark repo, then delete /tmp/shelfmark-sync*.
SULLIVAN_SSH_HOST=100.87.125.19
SULLIVAN_SSH_USER=shelfmark-sync
# rrsync chroots the connection to the category directory, so the remote root
# as Shelfmark sees it IS that directory.
SULLIVAN_COMPLETED_ROOT=/
